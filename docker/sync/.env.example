# Settings for the Notia sync server started by compose.yaml.
#
#   cd docker/sync
#   cp .env.example .env
#   # set NOTIA_SYNC_TOKEN in .env
#   docker compose up --build -d
#
# In Notia, Settings → Sync uses http://<this host>:8787 and the same token.
# The server listens on 8787 and compose publishes 8787:8787. That port is
# fixed; change both the published port and the container's --listen argument
# in compose.yaml if you need another one.
#
# Vaults live in the sync-data volume. On startup the image gives that
# directory to uid 10001, so a root-owned volume does not fail the first
# upload with Permission denied (os error 13).

# Shared secret Notia sends with every sync request, and the only password.
# The server accepts 1–512 printable ASCII characters with no spaces or
# newlines. Generate a long random value and keep .env out of version control
# (.gitignore already does):
#
#   openssl rand -hex 32
#
# Then use the same value in Notia → Settings → Sync. Replace the placeholder
# below before `docker compose up`: the server accepts this exact string, so
# leaving it as-is leaves a known password on your network. Publish the port
# only on a private network, or put HTTPS in front of this service.
NOTIA_SYNC_TOKEN=change-me-to-a-long-random-token
