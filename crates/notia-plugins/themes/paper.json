{
  "id": "paper",
  "name": "Paper",
  "version": "1.0.0",
  "author": "Notia",
  "description": "Warm paper, a serif note font and a narrow measure for long-form writing.",
  "themes": [
    {
      "name": "Paper",
      "mode": "light",
      "radius": 4,
      "radius.lg": 6,
      "shadow": false,
      "colors": {
        "background": "#fbf8f1",
        "foreground": "#2b2a26",
        "border": "#e7e0d0",
        "input.border": "#e0d8c6",
        "ring": "#a5502c",
        "caret": "#a5502c",
        "selection.background": "#a5502c2b",
        "muted.background": "#f0eadc",
        "muted.foreground": "#7a7366",
        "accent.background": "#ebe4d4",
        "accent.foreground": "#2b2a26",
        "primary.background": "#a5502c",
        "primary.foreground": "#fbf8f1",
        "secondary.background": "#f3eee2",
        "secondary.foreground": "#2b2a26",
        "secondary.hover.background": "#ebe4d4",
        "link": "#a5502c",
        "list.hover.background": "#ebe4d4",
        "list.active.background": "#a5502c1f",
        "list.active.border": "#a5502c00",
        "popover.background": "#fbf8f1",
        "popover.foreground": "#2b2a26",
        "sidebar.background": "#f3eee2",
        "sidebar.foreground": "#4a463e",
        "sidebar.border": "#e7e0d0",
        "sidebar.accent.background": "#ebe4d4",
        "sidebar.accent.foreground": "#2b2a26",
        "tab_bar.background": "#f3eee2",
        "tab.background": "#f3eee200",
        "tab.foreground": "#8a8274",
        "tab.active.background": "#fbf8f1",
        "tab.active.foreground": "#2b2a26",
        "title_bar.background": "#f3eee2",
        "title_bar.border": "#e7e0d0",
        "status_bar.background": "#f3eee2",
        "status_bar.border": "#e7e0d0",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#2b2a2622",
        "scrollbar.thumb.hover.background": "#2b2a2640",
        "overlay": "#2b2a2633",
        "drag.border": "#a5502c",
        "base.red": "#b8433a",
        "base.green": "#5f7f3a",
        "base.blue": "#3f6c8f",
        "base.yellow": "#b8860b",
        "base.magenta": "#8f5a8f",
        "base.cyan": "#3f8a85"
      },
      "highlight": {
        "editor.background": "#fbf8f1",
        "editor.foreground": "#2b2a26",
        "editor.active_line.background": "#f3eee280",
        "editor.line_number": "#c9c1b0",
        "editor.active_line_number": "#7a7366",
        "syntax": {
          "title": { "color": "#2b2a26", "font_weight": 700 },
          "punctuation.special": { "color": "#b5ad9c" },
          "punctuation.list_marker": { "color": "#a5502c" },
          "punctuation.delimiter": { "color": "#b5ad9c" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_text": { "color": "#a5502c" },
          "link_uri": { "color": "#a69f8f" },
          "text.literal": { "color": "#2b2a26" },
          "text.code.span": { "color": "#8f5a3a" },
          "comment": { "color": "#a69f8f", "font_style": "italic" },
          "keyword": { "color": "#a5502c" },
          "function": { "color": "#3f6c8f" },
          "string": { "color": "#5f7f3a" },
          "number": { "color": "#8f5a8f" },
          "boolean": { "color": "#a5502c" },
          "constant": { "color": "#8f5a8f" },
          "type": { "color": "#3f8a85" },
          "property": { "color": "#3f6c8f" },
          "attribute": { "color": "#3f8a85" },
          "operator": { "color": "#7a7366" },
          "tag": { "color": "#a5502c" },
          "punctuation": { "color": "#7a7366" }
        }
      },
      "notia": {
        "editor.font.family": "Georgia",
        "editor.font.size": 18,
        "editor.line_height": 1.75,
        "editor.max_width": 680
      }
    }
  ]
}
