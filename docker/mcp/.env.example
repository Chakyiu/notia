# Settings for the Notia MCP server started by compose.yaml.
#
#   cd docker/mcp
#   cp .env.example .env
#   # set NOTIA_MCP_TOKEN and NOTIA_VAULT
#   docker compose up --build -d
#
# The client URL is http://127.0.0.1:8788/mcp. Send the token as
# Authorization: Bearer <NOTIA_MCP_TOKEN>. Compose publishes that port on
# localhost only.
#
# NOTIA_VAULT is the notes folder on the host. It is mounted at /vault.
# On Docker Desktop, a Windows path can be C:/Users/me/Notes.
#
# The process user must be able to read and write that folder. The default
# is root inside the container, which can read Docker Desktop mounts. On
# Linux, set NOTIA_UID and NOTIA_GID to the account that owns the vault
# (`id -u` and `id -g`). This image does not chown the vault.

# Shared secret, and the only password. 1–512 printable ASCII characters
# with no spaces or newlines. Generate one and keep .env out of version
# control (.gitignore already ignores docker/mcp/.env):
#
#   openssl rand -hex 32
#
# Replace the placeholder before `docker compose up`. Leaving it as-is
# leaves a known password on the machine.
NOTIA_MCP_TOKEN=change-me-to-a-long-random-token

# Host path of the Notia vault.
NOTIA_VAULT=/absolute/path/to/vault

# Optional. Defaults are 0:0 (root in the container).
# NOTIA_UID=1000
# NOTIA_GID=1000
